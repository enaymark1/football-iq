# Copiar como .env en la raíz del proyecto. Ninguna variable es obligatoria:
# sin .env la app usa SQLite local y no necesita claves de API.

# Base de datos (cualquier URL de SQLAlchemy). Por defecto: backend/football_iq.db (SQLite).
# Usá rutas absolutas: una ruta relativa depende de la carpeta desde donde se ejecuta.
# Para PostgreSQL (instalar además psycopg[binary]):
# FIQ_DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/football_iq

# Orígenes que pueden llamar a la API (separados por coma)
FIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nombre del producto en la API
FIQ_APP_NAME=Football IQ

# Primera temporada de estadísticas de jugadores que se importa
FIQ_FIRST_PLAYER_SEASON=2019
