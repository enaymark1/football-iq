# Copiar como frontend/.env para personalizar. Nada es obligatorio.

# Nombre y subtítulo que se muestran en la interfaz
VITE_APP_NAME=Football IQ
VITE_APP_TAGLINE=Scouting & Analytics

# Fotos de jugadores y escudos enlazados desde la web (false = solo iniciales)
VITE_SHOW_IMAGES=true

# Backend al que apunta el proxy de desarrollo de Vite
VITE_BACKEND_URL=http://127.0.0.1:8000

# Solo para un build servido fuera de Vite: URL absoluta de la API (vacío = mismo origen)
VITE_API_URL=
